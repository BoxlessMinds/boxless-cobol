root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Fixed-format COBOL: code lives in columns 8-72.
[*.{cob,cbl,cpy}]
max_line_length = 72

[*.dat]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{ps1,cmd,bat}]
end_of_line = crlf

[*.{json,md}]
indent_size = 2
